# Copia este archivo como .env (NO lo subas a GitHub) para ejecutar en local.
# En GitHub Actions estos mismos nombres se configuran como "Repository secrets".

# --- Telegram (recomendado: gratis y llega al móvil al instante) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=            # varios separados por comas

# --- Correo (opcional; Gmail necesita "contraseña de aplicación") ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
EMAIL_FROM=

# --- Fuentes opcionales con API gratuita (más ofertas: InfoJobs, Indeed vía agregadores...) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
INFOJOBS_CLIENT_ID=
INFOJOBS_CLIENT_SECRET=
JOOBLE_API_KEY=
